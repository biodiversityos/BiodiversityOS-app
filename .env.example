# Public URL, embedded in the browser bundle.
NEXT_PUBLIC_INDEXER_URL=https://indexer.biodiversityos.org/graphql
# Server-side only. Points straight at the indexer container over the shared
# 'bos' network, so page rendering does not depend on public DNS resolving from
# inside Docker. Create the network once with: docker network create bos
INDEXER_INTERNAL_URL=http://indexer:4000/graphql
# How long a rendered page may reuse indexer results. Lower means new sightings
# appear sooner; higher means less load. Set 0 to disable caching.
INDEXER_REVALIDATE_SECONDS=60
NEXT_PUBLIC_CONTRACT_ADDRESS=0x...
NEXT_PUBLIC_WALLETCONNECT_PROJECT_ID=
NEXT_PUBLIC_BACKEND_URL=https://api.biodiversityos.org
# testnet = Celo Sepolia (default), mainnet = Celo mainnet
NEXT_PUBLIC_CHAIN=testnet
# Optional: override if the default testnet RPC is unreachable
NEXT_PUBLIC_TESTNET_RPC_URL=https://forno.celo-sepolia.celo-testnet.org
PORT=3001
